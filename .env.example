# Cybersecurity-AEGIS Environment Configuration
# Copy this file to .env and customize for your deployment.

# Core Orchestrator
DASHBOARD_API_PORT=8080
AEGIS_LOG_LEVEL=info
AEGIS_EVENT_BUFFER=10000

# Dashboard login. If unset, a random one-time password is generated and
# printed to stderr at startup.
AEGIS_ADMIN_USER=admin
AEGIS_ADMIN_PASSWORD=

# Shared secret for /api/v1/ingest/*. Every module signs its event posts
# with this key; without it the ingest API accepts unauthenticated writes.
# Generate with: openssl rand -hex 32
AEGIS_INGEST_KEY=

# Bind address. Leave unset for loopback; containers use 0.0.0.0:8070.
# AEGIS_BIND=127.0.0.1:8070

# PostgreSQL persistence (optional — leave empty for in-memory only)
AEGIS_DB_CONN=
# Example: AEGIS_DB_CONN=postgres://aegis:CHANGE_ME_LOCAL_ONLY@postgres:5432/aegis?sslmode=disable

# PostgreSQL credentials (used by docker-compose storage profile)
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY

# CyberShield AI ML/IDS
CYBERSHIELD_AI_PORT=8919
CYBERSHIELD_BINARY_MODEL=models/cybershield_realpro_binary_ensemble_v0_3.joblib
CYBERSHIELD_FAMILY_MODEL=models/cybershield_realpro_attack_family_v0_3.joblib
CYBERSHIELD_ANOMALY_MODEL=models/cybershield_realpro_anomaly_baseline_v0_3.joblib

# OT Monitor
MODBUS_HOST=127.0.0.1
MODBUS_PORT=502

# Industrial Site Assessment (port 8097)
# Richiede un riferimento di autorizzazione scritto per ogni assessment.
ASSESS_API_PORT=8097
ASSESS_BIND_HOST=127.0.0.1
AEGIS_ASSESS_DATA_DIR=data/site_assessment
AEGIS_ASSESS_AUDIT=data/site_assessment/audit.jsonl
AEGIS_ASSESS_MAX_CONCURRENT=1

# Threat Intelligence
ABUSEIPDB_API_KEY=

# Vulnerability Scanner
NVD_API_KEY=
VULN_ACTIVE_SCAN=false

# SOAR
SOAR_LIVE_MODE=false
